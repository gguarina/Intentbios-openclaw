{
  "id": "ash-book",
  "name": "Ash Book",
  "description": "Trilogy tools via book-runner: read, locks, PDF builds, and the locks-gated write path on ash/* branches.",
  "categories": ["other"],
  "activation": { "onStartup": true },
  "contracts": {
    "tools": ["book_status", "book_locks", "book_build", "book_file", "book_chapters", "book_chapter", "book_grep", "work_start", "work_edit", "work_write", "work_diff", "work_discard", "work_commit", "work_pr", "work_merge"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "runnerUrl": { "type": "string", "description": "Base URL of book-runner." },
      "buildsChannelId": { "type": "string", "description": "Discord channel id for #ash-builds." },
      "defaultBranch": { "type": "string", "description": "Branch used when a tool call omits one." }
    },
    "required": ["runnerUrl"]
  }
}
